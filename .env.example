# Leave DATABASE_URL unset to store settings and history in local JSON files (data/).
# Set it to use MySQL (required on Vercel, whose filesystem is read-only).
# DATABASE_URL=mysql://user:password@host:3306/okta_prep

# TLS is on by default for non-localhost hosts. Set to "false" to disable.
# DATABASE_SSL=true

# PEM certificate for providers that use their own CA (e.g. Aiven).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
